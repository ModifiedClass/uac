# ============================================================
#  统一认证中心 — 生产环境变量（方案 A）
# ============================================================

# JWT 签名密钥（≥ 32 字节强随机）
JWT_SECRET=x+dFErfVhFTuyPlPrHDs3LJ96tbv594++xvdv5bowKA=

# PostgreSQL
POSTGRES_USER=uac
POSTGRES_PASSWORD=G7#kL9@qZ2
POSTGRES_DB=uac

# Redis
REDIS_PASSWORD=G7#kL9@qZ2

# 服务器 IP（对外访问入口）
SERVER_IP=192.168.201.189

# ---------- Swarm 集群 ----------
NODES=192.168.201.189,192.168.201.181,192.168.201.190,192.168.201.191,192.168.201.193,192.168.201.182
SSH_PORT=60022
SSH_USER=root

# ---------- 镜像仓库 ----------
REGISTRY=192.168.201.194:5000
POSTGRES_IMAGE=${REGISTRY}/postgres:18
REDIS_IMAGE=${REGISTRY}/redis:7-alpine
NGINX_IMAGE=${REGISTRY}/nginx:1.27-alpine
AUTH_IMAGE=${REGISTRY}/uac-auth-center:latest

# ---------- Swarm 资源名 ----------
NETWORK_NAME=postgres-network-uac
PG_SERVICE=postgres18-cluster-uac
REDIS_SERVICE=redis-cluster-uac
AUTH_SERVICE=auth-center-uac
NGINX_SERVICE=nginx-uac

# ---------- 副本数（方案 A） ----------
# 有状态服务：单副本（多副本无意义，只会造成数据分裂）
PG_REPLICAS=1
REDIS_REPLICAS=1
# 无状态服务：多副本才有负载均衡意义
AUTH_REPLICAS=3
NGINX_REPLICAS=3

# ---------- 数据目录 ----------
PG_DATA_DIR=/data/postgresql18-uac
REDIS_DATA_DIR=/data/redis-uac
CONFIG_BASE_DIR=/codes/uac/docker