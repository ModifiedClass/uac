    "debounce": {
      "enabled": true,
      "windowMs": 1500
    }
  },

  "clients": [
    {
      "clientId": "fastapi-app",
      "clientSecret": "fastapi-app-secret",
      "name": "FastAPI 业务应用",
      "redirectUris": ["http://your-domain.com/callback"]
    }
  ],

